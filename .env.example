# Choose "gemini" (free API key) or "ollama" (fully offline)
LLM_PROVIDER=gemini

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash

# Only needed if LLM_PROVIDER=ollama  (run: ollama pull llama3.2)
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434

# Whisper size: tiny, base, small  (bigger = more accurate, slower)
WHISPER_MODEL=base
